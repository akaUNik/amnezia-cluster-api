# Application
# Keep false for shared, staged, and production deployments.
# Set DEVELOPMENT=true only for local development when you need /docs, /redoc, or /openapi.json.
DEVELOPMENT=false

# Server Configuration
SERVER_PUBLIC_HOST=your-server-ip-or-domain
# Name shown in Amnezia VPN app
SERVER_DISPLAY_NAME=My AmneziaWG Server

PROTOCOL_CONFIG_PATH=src/management/protocols.yaml

# API authentication
# Generate and store a strong key outside version control.
API_KEY=replace-with-strong-api-key
# Comma-separated hosts accepted by the API in production.
# If empty, SERVER_PUBLIC_HOST is used.
# API_ALLOWED_HOSTS=api.example.com,198.51.100.10
API_ENFORCE_HTTPS=true
API_KEY_FAILED_AUTH_LIMIT=10
API_KEY_FAILED_AUTH_WINDOW_SECONDS=60
API_KEY_FAILED_AUTH_BLOCK_SECONDS=60

# Nginx reverse proxy. Used when running: docker compose --profile nginx up --build
NGINX_SERVER_NAME=api.example.com
NGINX_CERTS_PATH=./nginx/certs
NGINX_CLIENT_MAX_BODY_SIZE=1m

# Peer status configuration (if you're haven't read docs yet, don't touch)
PERSISTENT_KEEPALIVE_SECONDS=25
PEER_ONLINE_THRESHOLD_SECONDS=180

# Central API sync configuration
# CENTRAL_API_URL=https://central-api.example.com/api/v1
# CENTRAL_API_KEY=replace-with-dedicated-central-sync-key
# CENTRAL_API_ALLOWED_HOSTS=central-api.example.com
SYNC_INTERVAL_SECONDS=60
