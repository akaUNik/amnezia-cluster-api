# Application
DEVELOPMENT=false
# Docker image tag used by docker-compose.yml on VPS.
API_IMAGE_TAG=latest

# Server Configuration
SERVER_PUBLIC_HOST=api.example.com
SERVER_DISPLAY_NAME=My AmneziaWG Server

PROTOCOL_CONFIG_PATH=src/management/protocols.yaml

# API authentication
# Generate and store a strong key outside version control.
API_KEY=replace-with-production-api-key
API_ALLOWED_HOSTS=api.example.com
API_ENFORCE_HTTPS=false
API_KEY_FAILED_AUTH_LIMIT=10
API_KEY_FAILED_AUTH_WINDOW_SECONDS=60
API_KEY_FAILED_AUTH_BLOCK_SECONDS=60

# Docker socket group on the host. Set on VPS with:
# stat -c '%g' /var/run/docker.sock
DOCKER_SOCKET_GID=0

# Nginx reverse proxy.
NGINX_SERVER_NAME=api.example.com
NGINX_CERTS_PATH=./nginx/certs
# Uncomment these paths when nginx should use certificates issued by certbot.
# NGINX_SSL_CERTIFICATE=/etc/letsencrypt/live/api.example.com/fullchain.pem
# NGINX_SSL_CERTIFICATE_KEY=/etc/letsencrypt/live/api.example.com/privkey.pem
NGINX_CLIENT_MAX_BODY_SIZE=1m
NGINX_RATE_LIMIT_RATE=60r/m
NGINX_RATE_LIMIT_BURST=20

# Certbot.
CERTBOT_EMAIL=admin@example.com
CERTBOT_DOMAIN=api.example.com
CERTBOT_LETSENCRYPT_PATH=./nginx/letsencrypt
CERTBOT_WWW_PATH=./nginx/certbot/www

# Peer status configuration
PERSISTENT_KEEPALIVE_SECONDS=25
PEER_ONLINE_THRESHOLD_SECONDS=180

# Central API sync configuration
# CENTRAL_API_URL=https://central-api.example.com/api/v1
# CENTRAL_API_KEY=replace-with-dedicated-central-sync-key
# CENTRAL_API_ALLOWED_HOSTS=central-api.example.com
SYNC_INTERVAL_SECONDS=60
