.git
.gitignore
.dockerignore
.venv
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store
.env
docs.local/

# TLS certificates and private key material must never enter the API image
# build context. The nginx service mounts certificates at runtime instead.
nginx/certs/*
!nginx/certs/.gitkeep
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
